{
  "name": "messenger",
  "version": "0.0.0",
  "scripts": {
    "start": "ng serve",
    "start:e2e": "ng serve --configuration e2e",
    "e2e:backend": "npm --prefix mock-backend run serve",
    "mock:demo": "MOCK_SEED=demo npm --prefix mock-backend run serve",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:coverage": "ng test --coverage --watch=false",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "e2e": "playwright test --grep-invert @visual",
    "e2e:visual": "playwright test --grep @visual",
    "prepare": "husky"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "bracketSpacing": true,
    "arrowParens": "always"
  },
  "lint-staged": {
    "*.{ts,html}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{scss,json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@fission-ai/openspec": "^1.10.0",
    "@playwright/test": "^1.60.0",
    "@softarc/eslint-plugin-sheriff": "^0.20.0",
    "@softarc/sheriff-core": "^0.20.0",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.0.8"
  }
}
